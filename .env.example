VITE_APP_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080
VITE_GITHUB_APP_SLUG=

# Cloudflare Workers production values:
# VITE_APP_URL=https://app.your-domain.com
# VITE_API_BASE_URL=/api
# NORULO_API_ORIGIN=https://api.your-domain.com
# NORULO_API_FALLBACK_ORIGIN=https://api-fallback.your-domain.com
# NORULO_PROXY_MAX_BODY_BYTES=1048576
#
# Cloudflare Pages proxy production values, if using functions/api/[[path]].js instead:
# VITE_APP_URL=https://app.your-domain.com
# VITE_API_BASE_URL=/api
# NORULO_API_ORIGIN=https://api.your-domain.com
# NORULO_API_FALLBACK_ORIGIN=https://api-fallback.your-domain.com
# NORULO_PROXY_MAX_BODY_BYTES=1048576
#
# NORULO_API_ORIGIN, NORULO_API_FALLBACK_ORIGIN, and
# NORULO_PROXY_MAX_BODY_BYTES are read by worker.js or functions/api/[[path]].js
# at runtime. They are not browser-exposed Vite settings.

# Leave the public GitHub App slug empty until the Norulo App is configured.
