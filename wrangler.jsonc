{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "norulo-web",
  "main": "./worker-entry.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-05-25",
  "routes": [
    {
      "pattern": "norulo.com",
      "custom_domain": true
    },
    {
      "pattern": "www.norulo.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "vars": {
    "NORULO_MODE": "production",
    "NORULO_API_ORIGIN": "https://api.norulo.com",
    "NORULO_CF_ACCOUNT_ID": "84e421f26c708c0cf437e287eed11fa1"
  },
  "services": [
    {"binding": "NORULO_SERVER", "service": "norulo-server-production"},
    {"binding": "NORULO_CONNECT_AUTH", "service": "norulo-connect", "entrypoint": "Authorization"}
  ],
  "observability": {
    "enabled": true,
    "issues": { "enabled": true },
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01,
      "persist": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
