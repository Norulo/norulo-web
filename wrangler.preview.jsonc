{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "norulo-web-preview",
  "main": "./worker-entry.js",
  "compatibility_date": "2026-05-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{"pattern": "preview.norulo.com", "custom_domain": true}],
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/*", "!/assets/*"]},
  "vars": {"NORULO_MODE": "preview", "NORULO_API_ORIGIN": "https://preview-api.norulo.com"},
  "services": [{"binding": "NORULO_SERVER", "service": "norulo-server-preview"}],
  "observability": {"enabled": false}
}
